# Production Environment Configuration for MS3-AGENDA-STOCK on AWS EC2 (us-east-1)
# Shared Docker Network: dental-net
COMPOSE_FILE=deploy/aws/compose.yml

# Application Settings
APP_NAME=MS3-AGENDA-STOCK
APP_ENV=production
APP_KEY=base64:PEGAR_AQUI_TU_APP_KEY_LARAVEL
APP_DEBUG=false
APP_URL=https://100-60-248-245.sslip.io
LOG_CHANNEL=stderr

# AWS Region & Native DynamoDB
# Uses EC2 Instance IAM Role via IMDSv2 default credential provider chain.
# DO NOT configure DYNAMODB_ENDPOINT, AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY in production.
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
DYNAMODB_FALLBACK_MEMORY=false

# Internal Service Communication (dental-net)
ML_SERVICE_URL=http://ml-service:8000

# Keycloak JWT Validation (Keycloak hosted on GCP; boots without reachable issuer, responds 401 on protected routes)
KEYCLOAK_ISSUER_URI=https://20-83-242-208.sslip.io/realms/dental-platform
KEYCLOAK_BASE_URL=https://20-83-242-208.sslip.io
KEYCLOAK_REALM=dental-platform
KEYCLOAK_AUDIENCE=ms3-agenda-stock
KEYCLOAK_ALGORITHM=RS256
KEYCLOAK_PUBLIC_KEY=
